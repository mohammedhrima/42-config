def cmd_login(config: dict, args: list) -> int:
    global ASK
    if any(arg != "--all" for arg in args):
        fail("42 login only takes --all", [], "run 42 to see the commands")
    if "--all" in args:
        ASK = False
    return run_steps(config, "login")


def cmd_logout(config: dict, args: list) -> int:
    if args:
        fail("42 logout takes no arguments", [], "run 42 to see the commands")
    return run_steps(config, "logout")


def cmd_env(config: dict, args: list) -> int:
    """Print `export` lines for the shell to evaluate.

    Only exports reach stdout. Running it twice gives the same PATH, because
    a folder already on PATH is never added again.
    """
    if args:
        fail("42 env takes no arguments", [], "run: eval \"$(42 env)\"")
    for name in exported_names(config) + ["PATH"]:
        print(f"export {name}={shlex.quote(os.environ.get(name, ''))}")
    return 0

USAGE = [
    ("42 login [--all]", "pick and set up this session's caches, tools and repos"),
    ("42 logout", "push your repos, then clean goinfre"),
    ("42 install [tool...]", "install tools, and what they need"),
    ("42 env", "print the exports that ~/.zshrc evaluates"),
]


def show_help(config: dict) -> None:
    intro("session runner for /goinfre")
    width = max(len(usage) for usage, _ in USAGE) + 3
    for usage, meaning in USAGE:
        print(_line([("│  ", GRAY), (usage.ljust(width), WHITE), (meaning, GRAY)], cut=False))
    print(_line([("│", GRAY)], cut=False))
    tools = ", ".join(config["tools"]) or "none yet"
    print(_line([("│  ", GRAY), ("tools".ljust(width), WHITE), (tools, GRAY)], cut=False))
    print(_line([("└  ", GRAY), ("config".ljust(width), WHITE),
                 (str(CONFIG_FILE), GRAY)], cut=False))


def cmd_install(config: dict, args: list) -> int:
    """`42 install name...` installs those tools; without names, it asks."""
    global ASK
    if "--all" in args:
        ASK = False
    names = [arg for arg in args if arg != "--all"]
    unknown = [name for name in names if name not in config["tools"]]
    if unknown:
        fail("not a tool in ~/42.yml: " + ", ".join(unknown), [],
             "tools: " + (", ".join(config["tools"]) or "none"))

    intro("install")
    if not names:
        names = pick("tools", choices_for(config, "tools"))
    else:
        heading("tools")
    if set_up_all(config, names):
        outro("installed. For this terminal: eval \"$(42 env)\"")
        return 0
    outro("some tools failed", RED)
    return 1


COMMANDS = {
    "login": cmd_login,
    "logout": cmd_logout,
    "install": cmd_install,
    "env": cmd_env,
}


def main(args: list) -> int:
    # Line by line, so 42's lines and the commands' output stay in order
    # even when everything goes to a file or a pipe.
    sys.stdout.reconfigure(line_buffering=True)

    config = load()
    prepare(config)
    if not args or args[0] in ("help", "-h", "--help"):
        show_help(config)
        return 0
    if args[0] not in COMMANDS:
        fail(f"unknown command {args[0]!r}", [], "run 42 to see the commands")
    try:
        return COMMANDS[args[0]](config, args[1:])
    except KeyboardInterrupt:
        print()
        outro("cancelled", RED)
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
